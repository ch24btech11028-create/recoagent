# Copy to `.env` and fill in. `.env` is gitignored; THIS FILE IS NOT.
#   cp .env.example .env
#
# Never put a real key in this file. It is a template and it is committed.
# `tests/test_no_secrets.py` fails the build if a key-shaped string appears here.
#
# Exporting in your shell also works and takes precedence over this file:
#   export NVIDIA_API_KEY=nvapi-...
#
# The deterministic rungs (B0, B2) need none of these. Only the agent tier
# (B3) and the settlement Q&A agent call a model.

# NVIDIA NIM -- the default host for the agent tier and Q&A.
NVIDIA_API_KEY=

# Anthropic, for `client_for("anthropic/claude-opus-5")`.
ANTHROPIC_API_KEY=

# OpenAI, for `client_for("openai/gpt-...")`.
OPENAI_API_KEY=

# Google, for `client_for("gemini/gemini-3.6-flash")`. Served over the
# OpenAI-compatible surface, so it goes through the same client as NIM. Note
# that a free-tier key has a zero quota on the `pro` models -- they return 429
# rather than a permission error, which reads like rate limiting and is not.
GEMINI_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Razorpay test mode. Dashboard -> Settings -> API Keys -> Generate Test Key.
# `pull` refuses an `rzp_live_` id: this project has no reason to hold a real
# merchant's transaction data, and the two prefixes differ by one word.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Dashboard -> Settings -> Webhooks -> Add New Webhook. Every delivery is
# HMAC-SHA256 checked against this over the raw body before it is stored.
RAZORPAY_WEBHOOK_SECRET=
